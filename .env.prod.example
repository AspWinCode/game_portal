# Copy to .env.prod on the VPS and fill in the secrets.
# docker-compose.prod.yml reads this file via env_file for the api service.

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_DB=game_game
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# DATABASE_URL is composed automatically by docker-compose from the vars above.
# If you need to override it, uncomment and edit:
# DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/game_game?schema=public

# ── Auth ───────────────────────────────────────────────────────────────────────
AUTH_SESSION_TTL_HOURS=12
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_MISSING_ORIGIN=false
AUTH_ALLOWED_ORIGINS=https://djam.tirskix.space

# ── Storage (local filesystem, served by the API) ─────────────────────────────
STORAGE_PROVIDER=local
LOCAL_UPLOADS_DIR=uploads
LOCAL_UPLOADS_PUBLIC_PREFIX=/uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif
UPLOAD_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm
UPLOAD_ALLOWED_FILE_MIME_TYPES=application/pdf,text/plain

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_HTTP_REQUESTS=true
LOG_ERROR_STACKS=false
LOG_FILE_PATH=
