DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_game?schema=public"
NEXT_PUBLIC_API_URL="https://your-domain.example/api"
NEXT_PUBLIC_SOCKET_URL="https://your-domain.example"
AUTH_SESSION_TTL_HOURS="12"
AUTH_MAX_ACTIVE_SESSIONS="5"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="true"
AUTH_ALLOW_MISSING_ORIGIN="false"
AUTH_ALLOWED_ORIGINS="https://your-web-origin.example"
UPLOAD_MAX_BYTES="26214400"
UPLOAD_ALLOWED_IMAGE_MIME_TYPES="image/png,image/jpeg,image/webp,image/gif"
UPLOAD_ALLOWED_VIDEO_MIME_TYPES="video/mp4,video/webm"
UPLOAD_ALLOWED_FILE_MIME_TYPES="application/pdf,text/plain"

STORAGE_PROVIDER="s3"
LOCAL_UPLOADS_DIR="uploads"
LOCAL_UPLOADS_PUBLIC_PREFIX="/uploads"

S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="game-game-media"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE_URL="https://cdn.example.com/game-game-media"
S3_CREATE_BUCKET_IF_MISSING="false"
MINIO_CONSOLE_URL=""
LOG_FILE_PATH=""
LOG_HTTP_REQUESTS="true"
LOG_ERROR_STACKS="false"
